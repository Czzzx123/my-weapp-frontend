# ---------- 依赖 ----------
# npm 安装产物，通过 package.json / package-lock.json 还原，不入库
node_modules/
# 开发者工具「构建 npm」产物，通过 package.json 还原，不入库
miniprogram_npm/

# ---------- 微信开发者工具 ----------
# 个人配置：含本地路径、appid、编译设置，因人而异
project.private.config.json

# ---------- 构建 / 缓存 ----------
dist/
*.log
.DS_Store
Thumbs.db
# Trunk 代码检查工具的缓存目录，内含完整源码快照（曾达 51MB），随本机生成不入库
.trunk/

# ---------- 编辑器 ----------
.idea/
.vscode/
*.swp

# ---------- 敏感信息 ----------
# 不要把密钥写进前端；如确有必要，用 .env.local 之类并由构建注入
.env
.env.local
