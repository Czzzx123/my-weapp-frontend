<!--
  完善资料引导：登录后弹一次，可跳过。

  为什么不做成强制流程：
  家长进来的首要目的是看孩子课表和课时，强制填资料会直接损失转化。
  这里只做「顺手帮你设一下」，设完或跳过都进首页。

  头像用 button open-type="chooseAvatar"，昵称用 input type="nickname" ——
  这两个是微信官方唯一允许的获取用户头像昵称的方式
  （getUserProfile 自基础库 2.27.1 起只返回灰头像和「微信用户」）。
-->
<t-popup visible="{{visible}}" placement="bottom" bind:visible-change="onPopupVisibleChange">
  <view class="guide">
    <view class="guide-head">
      <text class="guide-title">完善你的资料</text>
      <text class="guide-sub">方便老师认出你，也方便你自己区分账号</text>
    </view>

    <!-- 头像：点一下可选用微信头像或相册图片 -->
    <view class="guide-avatar-row">
      <button class="guide-avatar-btn"
              open-type="chooseAvatar"
              bindchooseavatar="onChooseAvatar"
              hover-class="guide-avatar-hover">
        <image class="guide-avatar"
               src="{{avatarPreview || '/images/icon/avatar-default.webp'}}"
               mode="aspectFill" />
        <view class="guide-avatar-badge">
          <t-icon name="camera" size="24rpx" color="#2F6BED" />
        </view>
      </button>
      <view class="guide-avatar-tip">
        <text class="guide-avatar-main">点头像可以换</text>
        <text class="guide-avatar-sub">能直接选用微信头像</text>
      </view>
    </view>

    <!-- 昵称：type="nickname" 时键盘上方会提示微信昵称 -->
    <view class="guide-field">
      <text class="guide-label">昵称</text>
      <form bindsubmit="onSubmit">
        <input class="guide-input"
               name="nickname"
               type="nickname"
               value="{{nickname}}"
               placeholder="{{defaultName}}"
               placeholder-class="guide-placeholder"
               maxlength="32"
               bindinput="onNicknameInput"
               bindblur="onNicknameBlur" />
        <!-- 用 form-type=submit 承载提交：微信在 onBlur 时会异步做内容安全检测，
             未通过会清空 input，只有在 submit 时读到的值才可靠。
             注意 input 必须带 name，否则 form 的 e.detail.value 是 {}，
             等于这套兜底完全没接上（曾经漏过）。 -->
        <button class="guide-submit" form-type="submit" hover-class="guide-submit-hover">
          保存并进入
        </button>
      </form>
    </view>

    <view class="guide-skip" bindtap="onSkip">
      <text>先跳过，以后再说</text>
    </view>
  </view>
</t-popup>
