/* 页面背景 */
.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* ===== 顶部用户信息区域 ===== */
.header {
  background: linear-gradient(135deg, #e8f4ff 0%, #d0e8ff 100%);
  padding: 0 32rpx 32rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #e0e0e0;
  margin-right: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
}

.user-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.username {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.phone {
  font-size: 26rpx;
  color: #999;
}

.login-tip {
  font-size: 26rpx;
  color: #1890ff;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.action-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}





.verify-text {
  font-size: 26rpx;
  color: #1890ff;
}

/* ===== 通用卡片样式 ===== */
.card {
  margin: 24rpx 32rpx 0;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* ===== 统计卡片 ===== */
.stats-row {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

/* ===== 功能网格卡片 ===== */
.feature-grid {
  display: flex;
  flex-wrap: wrap;
}

.feature-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
}

.feature-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: rgba(24, 144, 255, 0.08);
}

.feature-text {
  font-size: 24rpx;
  color: #666;
}

/* ===== 菜单列表卡片 ===== */
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 8rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-text {
  font-size: 30rpx;
  color: #333;
}

/* ===== 退出登录 ===== */
.logout-area {
  margin: 48rpx 32rpx 0;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  color: #ff4d4f;
  background-color: #fff;
  border: 2rpx solid #ff4d4f;
  border-radius: 44rpx;
}
