/* 页面背景 */
.page {
  min-height: 100vh;
  background-color: var(--wl-bg);
}

/* ===== 自定义导航标题（与右上角胶囊对齐） ===== */
.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: var(--wl-fs-h2);
  font-weight: 600;
  color: #ffffff;
  z-index: 3;
}

/* ===== 品牌渐变头部（叠压式） ===== */
.header {
  background: var(--wl-brand-gradient);
  padding: 0 var(--wl-sp-4) 88rpx;
  border-radius: 0 0 var(--wl-r-l) var(--wl-r-l);
}

.user-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--wl-sp-3);
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.3);
  margin-right: var(--wl-sp-3);
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  flex-shrink: 0;
}

/* 头像外层的 button：必须把所有默认样式清干净，否则会出现灰底和边框 */
.avatar-btn {
  position: relative;
  display: block;
  width: 112rpx;
  height: 112rpx;
  padding: 0;
  margin: 0 var(--wl-sp-3) 0 0;
  background: transparent;
  border: none;
  border-radius: 50%;
  line-height: 1;
  overflow: visible;
  flex-shrink: 0;
}

/* 微信 button 的默认 ::after 会画一圈边框，必须去掉 */
.avatar-btn::after {
  border: none;
}

.avatar-btn .avatar {
  margin-right: 0;
}

.avatar-btn-hover {
  opacity: 0.8;
}

/* 头像右下角的相机角标：提示「这里可以点」 */
.avatar-edit-badge {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.username {
  font-size: var(--wl-fs-h2);
  font-weight: 600;
  color: #ffffff;
}

.phone {
  margin-top: 6rpx;
  font-size: var(--wl-fs-sub);
  color: rgba(255, 255, 255, 0.85);
}

.login-tip {
  margin-top: 6rpx;
  font-size: var(--wl-fs-sub);
  color: rgba(255, 255, 255, 0.85);
}

/* 游客态登录按钮：白色反底胶囊 */
.login-btn {
  flex-shrink: 0;
  padding: 14rpx 36rpx;
  background: #ffffff;
  border-radius: var(--wl-r-pill);
  font-size: var(--wl-fs-sub);
  font-weight: 600;
  color: var(--wl-brand);
}

.settings-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

.tapable-hover {
  opacity: 0.86;
  transform: scale(0.98);
}

/* ===== 统计卡片（上浮叠压） ===== */
.stats-card {
  display: flex;
  margin: -48rpx var(--wl-sp-3) var(--wl-sp-3);
  position: relative;
  z-index: 2;
  padding: var(--wl-sp-4) var(--wl-sp-3);
  box-shadow: var(--wl-shadow-float);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-item + .stat-item {
  border-left: 1rpx solid var(--wl-divider);
}

.stat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--wl-brand-bg);
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--wl-brand);
}

.stat-label {
  font-size: var(--wl-fs-cap);
  color: var(--wl-text-2);
}

/* ===== 菜单列表卡片 ===== */
.menu-card {
  margin: 0 var(--wl-sp-3) var(--wl-sp-3);
  padding: 0 var(--wl-sp-3);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--wl-sp-3) 8rpx;
  border-bottom: 1rpx solid var(--wl-divider);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: var(--wl-sp-2);
}

.menu-text {
  font-size: 30rpx;
  color: var(--wl-text-1);
}

.menu-status {
  font-size: var(--wl-fs-cap);
  color: var(--wl-text-3);
}

/* ===== 退出登录（弱化：白卡内文字按钮，不做红描边） ===== */
.logout-card {
  margin: 0 var(--wl-sp-3) var(--wl-sp-3);
  padding: 0;
}

.logout-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: var(--wl-fs-body);
  color: var(--wl-error);
  background: transparent;
  border: none;
}

.logout-btn::after {
  border: none;
}
