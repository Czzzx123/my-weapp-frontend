<!--我的 界面-->
<view class="page">

  <!-- 自定义导航标题（与右上角胶囊对齐） -->
  <view class="nav-title"
        style="top: {{statusBarHeight}}px; height: {{navBarHeight}}px; line-height: {{navBarHeight}}px;">
    我的
  </view>

  <!-- 品牌渐变头部（叠压式，统计卡上浮 -48rpx） -->
  <view class="header" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
    <view class="user-row">
      <view class="user-info">
        <!--
          头像：已登录用 button open-type="chooseAvatar" 包起来，点一下就能换。
          微信自 2.27.1 起已不让程序静默拿用户头像（getUserProfile 只返回灰头像），
          但官方给了这个「头像昵称填写能力」——用户点选时可以选「用微信头像」，
          这是微信允许的唯一途径。
          游客态不能用 button（点了会触发选图），所以用 image 兜底。
        -->
        <button wx:if="{{userInfo}}"
                class="avatar-btn"
                open-type="chooseAvatar"
                bindchooseavatar="onChooseAvatar"
                hover-class="avatar-btn-hover">
          <image class="avatar"
                 src="{{userInfo.avatar || '/images/icon/avatar-default.webp'}}"
                 mode="aspectFill" />
          <view class="avatar-edit-badge">
            <t-icon name="camera" size="22rpx" color="#2F6BED" />
          </view>
        </button>
        <image wx:else
               class="avatar"
               src="/images/icon/avatar-default.webp"
               mode="aspectFill" />

        <view class="user-detail" bindtap="handleUserTap" hover-class="tapable-hover">
          <text class="username">{{userInfo.name || '游客'}}</text>
          <!-- 已绑定孩子优先展示孩子，没绑定才退回到手机号 -->
          <text class="phone" wx:if="{{userInfo}}">{{userInfo.childSummary || userInfo.mobileMasked || '未绑定孩子'}}</text>
          <text class="login-tip" wx:else>登录后查看孩子学习数据</text>
        </view>
      </view>

      <!-- 游客态：明确的登录按钮（替代不明确的"点击登录"文字） -->
      <view wx:if="{{!userInfo}}" class="login-btn tapable" bindtap="handleLogin">
        <text>登录 / 注册</text>
      </view>
      <view wx:else class="settings-btn tapable" bindtap="handleSetting">
        <t-icon name="setting" size="44rpx" color="#ffffff" />
      </view>
    </view>
  </view>

  <!-- 统计卡片（上浮叠压头部） -->
  <view class="card stats-card">
    <view class="stat-item" wx:for="{{stats}}" wx:key="key">
      <view class="stat-icon">
        <t-icon name="{{item.icon}}" size="40rpx" color="#2F6BED" />
      </view>
      <text class="stat-value">{{item.value}}</text>
      <text class="stat-label">{{item.label}}</text>
    </view>
  </view>

  <!-- 菜单列表卡片 -->
  <view class="card menu-card">
    <view class="menu-item"
          wx:for="{{menuList}}"
          wx:key="text"
          data-item="{{item}}"
          bindtap="handleMenuTap"
          hover-class="tapable-hover">
      <view class="menu-left">
        <t-icon name="{{item.icon}}" size="40rpx" color="#6B7280" />
        <text class="menu-text">{{item.text}}</text>
      </view>
      <!-- 有真实去向（含 action 类操作）才显示箭头；建设中显示状态文字 -->
      <t-icon wx:if="{{item.status === 'real' || item.action}}" name="chevron-right" size="32rpx" color="#9AA3AF" />
      <text wx:else class="menu-status">即将上线</text>
    </view>
  </view>

  <!-- 退出登录：弱化处理，白卡内文字按钮 -->
  <view wx:if="{{userInfo}}" class="card logout-card">
    <button class="logout-btn tapable" bindtap="handleLogout">退出登录</button>
  </view>

  <view class="safe-bottom"></view>

  <!--
    资料编辑弹层。和登录页用的是同一个组件，区别只有 mode：
    这里传 edit —— 不写「只弹一次」标记，每次点「修改昵称」都能打开。
    昵称输入框必须是 input type="nickname" 才能拉起微信昵称浮层，
    所以改昵称走这个组件，而不是 wx.showModal（那只是系统输入框）。
  -->
  <profile-guide
      mode="edit"
      visible="{{guideVisible}}"
      default-name="{{guideDefaultName}}"
      nickname-value="{{guideNickname}}"
      avatar-value="{{guideAvatar}}"
      bind:done="onGuideDone"
  />
</view>
