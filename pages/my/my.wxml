<!--我的 界面-->
<view class="page">

  <!-- 顶部用户信息区域 -->
  <view class="header" style="padding-top: {{statusBarHeight + 20}}px;">
    <view class="header-top">
      <view class="user-info" bindtap="{{userInfo ? '' : 'handleLogin'}}">
        <image class="avatar" src="{{userInfo.avatar || '/images/icon/icon.png'}}" mode="aspectFill" />
        <view class="user-detail">
          <text class="username">{{userInfo.name || '游客'}}</text>
          <text class="phone" wx:if="{{userInfo}}">151****108</text>
          <text class="login-tip" wx:else>点击登录</text>
        </view>
      </view>
      <view class="header-actions">
        <view class="action-btn" bindtap="handleMore">
          <t-icon name="ellipsis" size="44rpx" color="#fff" />
        </view>

      </view>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="card stats-card">
    <view class="stats-row">
      <view class="stat-item" wx:for="{{stats}}" wx:key="key">
        <t-icon name="{{item.icon}}" size="48rpx" color="#1890ff" />
        <text class="stat-value">{{item.value}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 功能网格卡片 -->
  <view class="card feature-card">
    <view class="feature-grid">
      <view 
        class="feature-item" 
        wx:for="{{features}}" 
        wx:key="text"
        data-index="{{index}}"
        bindtap="handleFeature"
      >
        <view class="feature-icon-wrap">
          <t-icon name="{{item.icon}}" size="48rpx" color="#1890ff" />
        </view>
        <text class="feature-text">{{item.text}}</text>
      </view>
    </view>
  </view>

  <!-- 菜单列表卡片 -->
  <view class="card menu-card">
    <view 
      class="menu-item" 
      wx:for="{{menuList}}" 
      wx:key="text"
      data-index="{{index}}"
      bindtap="handleMenuTap"
    >
      <view class="menu-left">
        <t-icon name="{{item.icon}}" size="40rpx" color="#666" />
        <text class="menu-text">{{item.text}}</text>
      </view>
      <t-icon name="chevron-right" size="36rpx" color="#ccc" />
    </view>
  </view>

  <!-- 退出登录按钮 -->
  <view class="logout-area" wx:if="{{userInfo}}">
    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </view>

</view>
