page {
    height: 100%;
    background-color: #f5f5f5;
}

.container {
    width: 100%;
    height: 100%;
    position: relative;
}

.container .img {
    width: 100%;
    height: 100%;
}

.jump {
    font-size: 26rpx;
    position: absolute;
    right: 32rpx;
    top: 60rpx;
    background-color: rgba(0, 0, 0, 0.5);
    color: #fff;
    padding: 10rpx 24rpx;
    border-radius: 40rpx;
    z-index: 10;
}
