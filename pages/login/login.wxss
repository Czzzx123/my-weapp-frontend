page {
    background-color: #f5f5f5;
}

.container {
    padding: 0 32rpx;
}

.main {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 80rpx;
}

.icon-view {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 60rpx;
}

.title {
    font-size: 36rpx;
    font-weight: 600;
    color: #333;
    margin-top: 16rpx;
}

.app-icon {
    width: 120rpx;
    height: 120rpx;
    border-radius: 24rpx;
}

.form-area {
    background-color: #fff;
    border-radius: 24rpx;
    padding: 32rpx 24rpx;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.code-row {
    display: flex;
    align-items: center;
    gap: 16rpx;
}

.code-input {
    flex: 1;
}

.code-btn {
    flex-shrink: 0;
}

.login-btn {
    margin-top: 40rpx;
}
