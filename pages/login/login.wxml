<view class="container">
    <view class="main">
        <view class="icon-view">
            <image src="/images/icon/icon.png" class="app-icon"></image>
            <text class="title">未蓝科技</text>
        </view>
    </view>

    <view class="form-area">
        <t-input
            value="{{phone}}"
            bind:change="onPhoneInput"
            label="手机号"
            type="tel"
            placeholder="请输入手机号"
            clearable="{{true}}"
        />

        <view class="code-row">
            <t-input
                value="{{code}}"
                bind:change="onCodeInput"
                label="验证码"
                placeholder="请输入验证码"
                clearable="{{true}}"
                class="code-input"
            />
            <t-button
                theme="primary"
                size="small"
                disabled="{{sendCodeDisabled}}"
                bind:tap="sendCode"
                class="code-btn"
            >{{buttonText}}</t-button>
        </view>

        <t-button theme="primary" block="{{true}}" bind:tap="login" class="login-btn">登录</t-button>
    </view>
</view>
