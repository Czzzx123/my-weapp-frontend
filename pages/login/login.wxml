<view class="page">
    <!-- 品牌区 -->
    <view class="brand">
        <image src="/images/icon/icon.png" class="app-icon"></image>
        <text class="brand-name">未蓝科技</text>
        <text class="brand-slogan">陪伴每一次成长</text>
    </view>

    <!-- 表单卡片 -->
    <view class="form-card">
        <t-input
            value="{{phone}}"
            bind:change="onPhoneInput"
            label="手机号"
            type="number"
            maxlength="{{11}}"
            placeholder="请输入手机号"
            clearable="{{true}}"
        />
        <!-- 字段级错误：内联红字优先于 Toast -->
        <view wx:if="{{phoneError}}" class="field-error">{{phoneError}}</view>

        <view class="code-row">
            <t-input
                value="{{code}}"
                bind:change="onCodeInput"
                label="验证码"
                type="number"
                maxlength="{{6}}"
                placeholder="请输入验证码"
                clearable="{{true}}"
                class="code-input"
            />
            <button
                class="code-btn {{sendCodeDisabled ? 'code-btn-counting' : ''}}"
                disabled="{{sendCodeDisabled || sending}}"
                bindtap="sendCode"
                hover-class="tapable-hover"
            >{{sending ? '发送中…' : buttonText}}</button>
        </view>

        <t-button
            theme="primary"
            block="{{true}}"
            loading="{{loading}}"
            disabled="{{!canSubmit}}"
            bind:tap="login"
            class="login-btn"
        >{{loading ? '登录中…' : '登 录'}}</t-button>

        <!-- 隐私协议（P0 合规） -->
        <view class="agreement" bindtap="onToggleAgree" hover-class="tapable-hover">
            <view class="checkbox {{agreed ? 'checkbox-checked' : ''}}">
                <t-icon wx:if="{{agreed}}" name="check" size="24rpx" color="#ffffff" />
            </view>
            <view class="agreement-text">
                <text>我已阅读并同意</text>
                <text class="link" catchtap="onViewProtocol" data-type="service">《用户服务协议》</text>
                <text>和</text>
                <text class="link" catchtap="onViewProtocol" data-type="privacy">《隐私政策》</text>
            </view>
        </view>
    </view>

    <!-- 分隔线 -->
    <view class="divider">
        <view class="divider-line"></view>
        <text class="divider-text">其他登录方式</text>
        <view class="divider-line"></view>
    </view>

    <!-- 微信一键登录：走 wx.login() 静默取 code，无需授权弹窗 -->
    <view class="wx-login-wrap">
        <view class="wx-login-btn {{wxLoading ? 'wx-login-btn-loading' : ''}}"
              bindtap="wxLogin"
              hover-class="{{wxLoading ? '' : 'tapable-hover'}}">
            <t-icon name="logo-wechat-stroke" size="40rpx" color="#07C160" />
            <text class="wx-login-text">{{wxLoading ? '登录中…' : '微信一键登录'}}</text>
        </view>
        <view class="wx-login-tip">微信登录后可补充手机号，用于关联孩子的课程</view>
    </view>

    <!-- 开发提示 -->
    <view class="demo-tip">
        <t-icon name="info-circle" size="28rpx" color="#9AA3AF" />
        <text>开发模式：验证码固定 8888，暂未真实下发短信</text>
    </view>

    <view class="safe-bottom"></view>

    <!-- 完善资料引导：首次登录且昵称头像都为空时弹一次，可跳过 -->
    <profile-guide
        visible="{{guideVisible}}"
        default-name="{{guideDefaultName}}"
        nickname-value="{{guideNickname}}"
        avatar-value="{{guideAvatar}}"
        bind:done="onGuideDone"
    />
</view>
