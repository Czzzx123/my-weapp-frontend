page {
    background-color: #f5f5f5;
}

.container {
    padding: 24rpx 32rpx;
}

.activity-card {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    background-color: #fff;
    border-radius: 24rpx;
    padding: 32rpx 24rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.activity-content {
    flex: 1;
    margin-right: 24rpx;
}

.activity-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
    margin-bottom: 16rpx;
}

.activity-info {
    display: flex;
    align-items: center;
    gap: 8rpx;
    font-size: 24rpx;
    color: #999;
    margin-bottom: 8rpx;
}

.activity-description {
    font-size: 26rpx;
    color: #666;
    margin-top: 16rpx;
    line-height: 1.6;
}

.empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 120rpx;
    gap: 16rpx;
}

.empty-text {
    font-size: 28rpx;
    color: #999;
}
