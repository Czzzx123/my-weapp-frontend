page {
    background-color: var(--wl-bg);
}

/* 复用 app.wxss .container / .card */

/* ===== 建设中提示 ===== */
.dev-tip {
    display: flex;
    align-items: center;
    padding: 12rpx var(--wl-sp-2);
    margin-bottom: var(--wl-sp-3);
    background: var(--wl-accent-bg);
    border-radius: var(--wl-r-s);
    font-size: var(--wl-fs-cap);
    color: var(--wl-text-2);
}

.dev-dot {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
    background: var(--wl-accent);
    margin-right: var(--wl-sp-1);
    flex-shrink: 0;
}

/* ===== 功能网格 ===== */
.grid-wrap {
    display: flex;
    flex-wrap: wrap;
    padding: var(--wl-sp-4) var(--wl-sp-2) var(--wl-sp-2);
}

/* 每个网格项：4列布局 */
.grid-item {
    width: 25%;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 160rpx;
    margin-bottom: var(--wl-sp-4);
    box-sizing: border-box;
}

.tapable-hover {
    opacity: 0.86;
    transform: scale(0.98);
}

/* 图标容器：96rpx 圆底 + 48rpx t-icon */
.icon-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 96rpx;
    height: 96rpx;
    border-radius: 50%;
    margin-bottom: var(--wl-sp-2);
}

/* 建设中圆点（视觉预告，不铺文字角标） */
.dot {
    position: absolute;
    top: 4rpx;
    right: 4rpx;
    width: 14rpx;
    height: 14rpx;
    border-radius: 50%;
    background: var(--wl-accent);
    border: 3rpx solid var(--wl-surface);
    box-sizing: border-box;
}

/* 红点徽标（预留，红色仅留给未读/错误） */
.badge {
    position: absolute;
    top: -4rpx;
    right: -4rpx;
    min-width: 32rpx;
    height: 32rpx;
    padding: 0 8rpx;
    border-radius: 16rpx;
    background-color: var(--wl-error);
    color: #ffffff;
    font-size: var(--wl-fs-mini);
    line-height: 32rpx;
    text-align: center;
    box-sizing: border-box;
}

/* 功能名称 */
.menu-label {
    font-size: var(--wl-fs-cap);
    color: var(--wl-text-1);
    white-space: nowrap;
}

/* 建设中项略降不透明度 */
.grid-item-disabled {
    opacity: 0.9;
}

/* 第 8 格占位：纯展示 */
.grid-item-placeholder {
    opacity: 0.55;
}

.icon-wrap-placeholder {
    background: var(--wl-divider);
}

.menu-label-muted {
    color: var(--wl-text-3);
}
