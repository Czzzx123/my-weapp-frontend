<!--首页-->
<view class="container">
    <view class="banner">
        <swiper autoplay circular indicator-color="#ddd" interval="3000" style="height: 360rpx;">
            <swiper-item wx:for="{{banner_list}}" wx:key="*this">
                <image src="{{item.img}}" mode="aspectFill" style="width: 100%; height: 100%;" />
            </swiper-item>
        </swiper>
    </view>

    <!--通知-->
    <t-notice-bar content="{{notice}}" prefixIcon="sound" theme="info"  visible="{{visible}}"  marquee="{{marquee1}}">

    </t-notice-bar>

    <!--上课日常-->
    <view class="daily-section">
        <view class="section-header">
            <t-icon name="time" size="40rpx" color="#1890ff" />
            <text class="section-title">上课日常</text>
        </view>

        <view class="daily-card" wx:for="{{daily_list}}" wx:key="id">
            <view class="card-date">
                <t-icon name="calendar" size="28rpx" color="#ffffff" />
                <text>{{item.date}}</text>
            </view>
            <image class="card-img" src="{{item.img}}" mode="aspectFill" />
            <view class="card-content">{{item.content}}</view>
            <view class="card-footer">
                <view class="action" bindtap="onCollect">
                    <t-icon name="heart" size="36rpx" color="#999" />
                    <text>收藏</text>
                </view>
                <view class="action" bindtap="onShare">
                    <t-icon name="share" size="36rpx" color="#999" />
                    <text>分享</text>
                </view>
            </view>
        </view>
    </view>

</view>