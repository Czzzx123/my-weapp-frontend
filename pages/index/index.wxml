<!--首页-->
<view class="page">

    <!-- Banner 轮播：渐变卡片式（后端返回 img 时自动切换为图片模式） -->
    <swiper class="banner-swiper"
            autoplay
            circular
            indicator-dots
            indicator-color="rgba(255,255,255,0.45)"
            indicator-active-color="#ffffff"
            interval="4000"
            duration="400">
        <swiper-item wx:for="{{banner_list}}" wx:key="index">
            <!-- 图片模式：后端下发 img 时启用 -->
            <image wx:if="{{item.img}}" class="banner-img" src="{{item.img}}" mode="aspectFill" lazy-load="{{true}}" />
            <!-- 渐变文案模式：默认 -->
            <view wx:else class="banner-card banner-{{item.theme || 'blue'}}">
                <view class="banner-text">
                    <text class="banner-tag">{{item.tag}}</text>
                    <text class="banner-title">{{item.title}}</text>
                    <text class="banner-sub">{{item.subtitle}}</text>
                </view>
                <view class="deco-circle deco-circle-1"></view>
                <view class="deco-circle deco-circle-2"></view>
            </view>
        </swiper-item>
    </swiper>

    <!-- 公告通知卡（可关闭，当日关闭后不再弹出） -->
    <view wx:if="{{noticeVisible}}" class="notice-card card">
        <t-icon name="sound" size="36rpx" color="#2F6BED" />
        <text class="notice-text">{{notice}}</text>
        <view class="notice-close tapable" bindtap="closeNotice" aria-label="关闭公告">
            <t-icon name="close" size="32rpx" color="#9AA3AF" />
        </view>
    </view>

    <!-- 上课日常 -->
    <view class="section-header">
        <view class="section-left">
            <view class="section-bar"></view>
            <text class="section-title">上课日常</text>
        </view>
        <text class="section-more tapable" bindtap="gotoActivity">查看全部</text>
    </view>

    <view class="daily-card card" wx:for="{{daily_list}}" wx:key="id">
        <!--
            通栏图：课程/活动的实拍展示，放在标题下方、正文上方。
            后端没配图时整块不渲染（img 为空串也走 else 分支），
            卡片会自然回到纯文字版式，不会留一块空白。
            模式用 aspectFill + 固定高度：运营上传的图比例各不相同，
            裁切比留白好看，也不会把卡片高度撑得乱七八糟。
        -->
        <image wx:if="{{item.img}}"
               class="daily-img"
               src="{{item.img}}"
               mode="aspectFill"
               lazy-load="{{true}}"
               binderror="onDailyImgError"
               data-id="{{item.id}}" />

        <!-- 卡片头：标题 + 日期 -->
        <view class="daily-inner">
            <view class="card-head">
                <text class="card-title">{{item.title}}</text>
                <view class="card-date">
                    <t-icon name="calendar" size="26rpx" color="#9AA3AF" />
                    <text>{{item.date}}</text>
                </view>
            </view>

            <!-- 课程标签 + 正文 -->
            <view class="card-body">
                <text class="course-tag course-{{item.theme}}">{{item.course}}</text>
                <view class="card-content">{{item.content}}</view>
            </view>

            <!-- 操作区 -->
            <view class="card-footer">
                <view class="action tapable {{item.collected ? 'action-active' : ''}}"
                      bindtap="onCollect"
                      data-id="{{item.id}}">
                    <t-icon name="{{item.collected ? 'heart-filled' : 'heart'}}"
                            size="36rpx"
                            color="{{item.collected ? '#FF7A85' : '#9AA3AF'}}" />
                    <text>{{item.collected ? '已收藏' : '收藏'}}</text>
                </view>
                <view class="footer-divider"></view>
                <button class="action share-btn tapable" open-type="share" data-id="{{item.id}}">
                    <t-icon name="share" size="36rpx" color="#9AA3AF" />
                    <text>分享</text>
                </button>
            </view>
        </view>
    </view>

    <!-- 后台还没录入内容：明确告知，不要用假数据冒充 -->
    <view wx:if="{{dailyEmpty}}" class="daily-empty card">
        <t-icon name="image" size="64rpx" color="#D5DBE4" />
        <text class="daily-empty-text">课程动态正在整理中，稍后再来看看</text>
    </view>

    <view class="safe-bottom"></view>

    <!-- 订阅提醒引导弹层
         为什么自己画一个而不是直接调微信授权框：见 index.js 的 initSubscribe 注释。
         文案只讲「你会收到什么」，不讲「一次性订阅有几条额度」——
         家长关心的是能不能收到，不是机制。 -->
    <view wx:if="{{subscribeVisible}}" class="sub-mask" catchtouchmove="noop">
        <view class="sub-sheet">
            <view class="sub-icon">
                <t-icon name="notification" size="56rpx" color="#2F6BED" />
            </view>
            <text class="sub-title">开启上课提醒</text>
            <text class="sub-desc">开启后，下面这些消息会通过微信通知你：</text>

            <view class="sub-list">
                <view class="sub-item">
                    <view class="sub-dot"></view>
                    <text class="sub-item-text">上课前提醒，别忘了送孩子</text>
                </view>
                <view class="sub-item">
                    <view class="sub-dot"></view>
                    <text class="sub-item-text">孩子签到成功，到校即知道</text>
                </view>
            </view>

            <view class="sub-accept tapable" bindtap="onSubscribeAccept">开启提醒</view>
            <view class="sub-later tapable" bindtap="onSubscribeClose">暂不需要</view>
            <view class="sub-mute tapable" bindtap="onSubscribeMute">不再提示</view>
        </view>
    </view>
</view>
