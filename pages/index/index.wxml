<view class="container">
    <view class="banner">
        <swiper autoplay indicator-dots circular indicator-color="#FFFFF" interval="3000">
            <swiper-item wx:for="{{banner_list}}" wx:key="*this">
                <image src="{{item.img}}" mode="widthFix" />
            </swiper-item>
        </swiper>
    </view>

    <!--通知-->
    <van-notice-bar left-icon="volume-o" text="{{notice}}" />

    <van-grid column-num="3">
        <van-grid-item icon="/images/menu/ht.png" text="信息采集" bind:click='gotoCollection' />
        <van-grid-item icon="/images/menu/sqhd.png" text="社区活动" bind:click='gotoActivity' />
        <van-grid-item icon="/images/menu/rljc.png" text="人脸检测" bind:click='gotoFace' />
        <van-grid-item icon="/images/menu/yysb.png" text="语音识别" bind:click='gotoVoice' />
        <van-grid-item icon="/images/menu/xljc.png" text="心率检测" bind:click='gotoHeart' />
        <van-grid-item icon="/images/menu/jfsc.png" text="积分商城" bind:click='gotoGoods' />
    </van-grid>


    <view class='bottom'>
        <view>
            <image src="/images/home/cute_1.jpg" mode="scaleToFill" />
        </view>
        <view>
            <image src="/images/home/cute_2.jpg" mode="scaleToFill" />
        </view>
        <view>
            <image src="/images/home/cute_3.jpg" mode="scaleToFill" />
        </view>
        <view>
            <image src="/images/home/cute_4.jpg" mode="scaleToFill" />
        </view>
    </view>

</view>